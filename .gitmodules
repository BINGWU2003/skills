# 使用 `git submodule add <repository-url> sources/<project-name>` 添加 Skill 来源。
[submodule "sources/agent-git"]
	path = sources/agent-git
	url = https://github.com/BINGWU2003/agent-git.git
	branch = main
[submodule "sources/weekly-git-report"]
	path = sources/weekly-git-report
	url = https://github.com/BINGWU2003/weekly-git-report.git
	branch = main
