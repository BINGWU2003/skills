# 使用 `git submodule add <repository-url> sources/<project-name>` 添加 Skill 来源。
[submodule "sources/agent-git"]
	path = sources/agent-git
	url = https://github.com/BINGWU2003/agent-git.git
	branch = main
[submodule "sources/weekly-git-report"]
	path = sources/weekly-git-report
	url = https://github.com/BINGWU2003/weekly-git-report.git
	branch = main
[submodule "sources/mattpocock-skills"]
	path = sources/mattpocock-skills
	url = https://github.com/mattpocock/skills.git
[submodule "sources/excalidraw-diagram-skill"]
	path = sources/excalidraw-diagram-skill
	url = https://github.com/coleam00/excalidraw-diagram-skill.git
[submodule "sources/drawio-skill"]
	path = sources/drawio-skill
	url = https://github.com/Agents365-ai/drawio-skill.git
[submodule "sources/gitlab-ai-skills"]
	path = sources/gitlab-ai-skills
	url = https://gitlab.com/gitlab-org/ai/skills.git
